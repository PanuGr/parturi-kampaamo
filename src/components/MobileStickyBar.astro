---
import { Phone, Calendar } from "@lucide/astro";
import { SALON_INFO } from "../data/site";
---

<aside class="mobile-sticky-bar p-2 gap-2" aria-label="Pikatoiminnot mobiilissa">
  <a href={SALON_INFO.phoneTel} class="btn btn-luxury-outline flex-fill d-flex align-items-center justify-content-center gap-1">
    <Phone size={18} />
    <span class="small">Soita</span>
  </a>
  <a href={SALON_INFO.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-luxury-dark flex-fill d-flex align-items-center justify-content-center gap-1">
    <Calendar size={18} />
    <span class="small">Varaa aika</span>
  </a>
</aside>
