---
import { Phone } from "@lucide/astro";
import { SALON_INFO } from "../data/site";
---

<header class="sticky-top header-nav py-3">
  <div class="container-xl d-flex justify-content-between align-items-center">
    <a href="#" class="brand-title" aria-label="Parturi-Kampaamo etusivulle">
      PARTURI-KAMPAAMO
    </a>
    
    <div class="d-flex align-items-center gap-4">
      <a href={SALON_INFO.phoneTel} class="d-none d-md-inline-flex align-items-center gap-2 text-decoration-none text-dark small fw-medium">
        <Phone class="lucide-icon text-muted" size={18} />
        <span>Puh. {SALON_INFO.phone}</span>
      </a>
      <a href={SALON_INFO.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-luxury-dark py-2 px-3 small">
        Varaa aika
      </a>
    </div>
  </div>
</header>
