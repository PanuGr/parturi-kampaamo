---
import { SALON_INFO } from "../data/site";
const currentYear = new Date().getFullYear();
---

<footer class="py-4 bg-white">
  <div class="container-xl d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
    <div class="small text-secondary">
      © {currentYear} {SALON_INFO.name}. Kaikki oikeudet pidätetään.
    </div>
    <div class="d-flex gap-4 small">
      <a href="#privacyModal" data-bs-toggle="modal" data-bs-target="#privacyModal" class="text-secondary text-decoration-none">
        Tietosuojaseloste
      </a>
      <a href="#accessibilityModal" data-bs-toggle="modal" data-bs-target="#accessibilityModal" class="text-secondary text-decoration-none">
        Saavutettavuusseloste
      </a>
        <a href={SALON_INFO.phoneTel} class="text-secondary text-decoration-none">
        Puh. {SALON_INFO.phone}
      </a>
    </div>
  </div>
<small class="d-block fw-bold text-center m-auto">
        Esittelysivu. Haluatko yrityksellesi samanlaisen? Toteutus:
        <a href="https://digisolutech.fi" target="_blank">Digisolutech →</a>
      </small>
</footer>
