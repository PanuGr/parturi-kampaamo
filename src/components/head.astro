---
import "../styles/index.scss";
import { SEOMetadata } from "astro-seo-metadata";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SOCIAL_IMAGE,
  FAVICON,
  SALON_INFO,
} from "../data/site";
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="color-scheme" content="light" />

<!-- Bunny Fonts (GDPR compliant: Inter & Playfair Display) -->
<link rel="preconnect" href="https://fonts.bunny.net" />
<link href="https://fonts.bunny.net/css?family=inter:400,500,600|playfair-display:400,500,600&display=swap" rel="stylesheet" />

<link rel="sitemap" href="/sitemap-0.xml" />
<meta name="keywords" content={SITE_KEYWORDS} />
<SEOMetadata
  siteName={SITE_TITLE}
  title={title || SITE_TITLE}
  description={description || SITE_DESCRIPTION}
  image={image || SOCIAL_IMAGE}
  favicon={FAVICON}
  author="Panagiotis Panagiotakopoulos"
  astroSitemap={true}
  canonicalUrl={Astro.url.toString()}
  type={"website"}
  astroGenerator={true}
/>

<!-- Scripts -->
<script>
  const isDev = import.meta.env.DEV;

  if (isDev) {
    import("bootstrap");
  } else {
    import("bootstrap/js/dist/button");
    import("bootstrap/js/dist/collapse");
    import("bootstrap/js/dist/modal");
  }
</script>

<script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HairSalon",
    "name": "Parturi-Kampaamo",
    "description": "Ylellinen ja rentouttava parturi-kampaamo Turun keskustassa. Selkeä hinnoittelu, asiantunteva palvelu ja 100 % tyytyväisyystakuu.",
    "url": "https://parturi-kampaamo.netlify.app/",
    "telephone": "+358101234567",
    "priceRange": "€€",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Puutarhakatu 19",
      "addressLocality": "Turku",
      "postalCode": "20100",
      "addressCountry": "FI"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "19:00"
      },
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Saturday"],
        "opens": "10:00",
        "closes": "16:00"
      }
    ]
  }
</script>
