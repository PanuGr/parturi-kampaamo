---
import Layout from "./Layout.astro";
import { parseDate, formatDateFI } from "../data/date";

export interface Props {
  frontmatter: {
    title: string;
    description: string;
    date: string;
    image: string;
    tags: string[];
    hideBackLink?: boolean;
    category: string;
  };
  relatedPosts?: import("astro:content").CollectionEntry<"blog">[];
}

const { frontmatter, relatedPosts } = Astro.props;

// Use shared utility for date parsing and formatting
const dateObj = parseDate(frontmatter.date);
const formattedDate = formatDateFI(dateObj);

const renderedContent = await Astro.slots.render("default");
const cleanContent = renderedContent.replace(/<[^>]*>?/gm, "");
const words = cleanContent.split(/\s+/).filter(word => word.length > 0);
const wordCount = words.length;
const readingTimeMinutes = Math.ceil(wordCount / 200);
const readingTimeText = `${readingTimeMinutes} min lukuaika`;
---

<Layout
  title={`${frontmatter.title} | DigiSolutech blog`}
  description={frontmatter.description || ""}
  image={frontmatter.image}
>
  <style is:inline>
    #hero {
      display: none !important;
    }

    /* Proset styles for Markdown content */
    .prose {
      font-size: 1.25rem;
      line-height: 1.8;
    }
    .prose p {
      margin-bottom: 1.8rem;
    }

    .prose ul,
    .prose ol {
      margin-bottom: 1.8rem;
      padding-left: 1.5rem;
    }

    .prose li {
      margin-bottom: 0.5rem;
    }
  </style>

  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      inLanguage: "fi-FI",
      headline: frontmatter.title,
      articleSection: frontmatter.category,
      description: frontmatter.description,
      image: {
        "@type": "ImageObject",
        url:
          frontmatter.image ||
          "https://digisolutech.netlify.app/images/apple.png",
      },
      keywords: frontmatter.tags ? frontmatter.tags.join(", ") : undefined,
      wordCount: wordCount,
      // converts date to YYYY-MM-DD format for schema compatibility
      datePublished: dateObj ? dateObj.toISOString() : new Date(frontmatter.date.split('.').reverse().join('-')).toISOString(),
      dateModified: dateObj ? dateObj.toISOString() : new Date(frontmatter.date.split('.').reverse().join('-')).toISOString(),
      author: {
        "@type": "Person",
        name: "Panagiotis Panagiotakopoulos",
        url: "https://digisolutech.netlify.app/#person",
        image: "https://digisolutech.netlify.app/images/me.avif",
        jobTitle: "Verkkosivusuunnittelija",
        worksFor: {
          "@id": "https://digisolutech.netlify.app/#organization",
        },
        sameAs: [
          "https://www.facebook.com/profile.php?id=61589313329650",
          "https://www.youtube.com/@digisolutech",
          "https://www.linkedin.com/in/panagiotis-panagiotakopoulos",
          "https://www.instagram.com/digisolutech5081/",
          "https://www.google.com/maps?cid=15102198032253865202"
        ],
      },
      publisher: {
        "@type": "Organization",
        "@id": "https://digisolutech.netlify.app/#organization",
        name: "DigiSolutech",
        logo: "https://digisolutech.netlify.app/images/apple.png",
        url: "https://digisolutech.netlify.app",
        sameAs: [
          "https://www.facebook.com/profile.php?id=61589313329650",
          "https://www.youtube.com/@digisolutech",
          "https://www.linkedin.com/in/panagiotis-panagiotakopoulos",
          "https://www.instagram.com/digisolutech5081/",
          "https://www.google.com/maps?cid=15102198032253865202"
        ]
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.toString(),
      },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: ["#article-headline"],
      },
    })}
  />

  <main id="main-content" class="container py-5 mt-5" style="max-width: 850px;">
    {
      !frontmatter.hideBackLink && (
        <a
          href="/blog"
          class="btn btn-link p-0 mb-5 text-decoration-none d-inline-flex align-items-center gap-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          Takaisin tietopankkiin
        </a>
      )
    }

    <article class="blog-post">
      <header class="text-center mb-5">
        {
          frontmatter.tags && frontmatter.tags.length > 0 && (
            <div class="d-flex flex-wrap justify-content-center gap-2 mb-4">
              {frontmatter.tags.map((tag) => (
                <a
                  href={`/blog/tagi/${tag.toLowerCase().replace(/\s+/g, "-")}`}
                  class="text-uppercase rounded-pill btn btn-outline-primary"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }
        <h1 id="article-headline" class="display-3 fw-extrabold text-white mb-4">
          {frontmatter.title}
        </h1>
        <div class="text-muted small">
          <time
            datetime={dateObj
              ? dateObj.toISOString().split("T")[0]
              : frontmatter.date}>{formattedDate}</time
          >
          <span class="mx-2">•</span>
          <span>{readingTimeText}</span>
        </div>
      </header>

      {
        frontmatter.image && (
          <img
            src={frontmatter.image}
            alt={frontmatter.title}
            class="article-hero-image rounded-5 mb-5"
            onerror="this.style.display='none'"
          />
        )
      }

      <div class="prose">
        <slot />
      </div>
    </article>

    {
      relatedPosts && relatedPosts.length > 0 && (
        <section class="mt-5 pt-5 border-top border-secondary-subtle">
          <h2 class="h3 fw-bold text-white mb-4">
            Samankaltaisia artikkeleita
          </h2>
          <div class="row g-4">
            {relatedPosts.map((post) => (
              <div class="col-md-4">
                <a
                  href={`/blog/${post.id}`}
                  class="card text-decoration-none h-100"
                >
                  <div class="card-body p-4 d-flex flex-column">
                    <span class="text-accent fw-bold text-uppercase small ls-1 mb-2">
                      {post.data.category}
                    </span>
                    <h3 class="card-title h5 fw-bold text-white mb-3">
                      {post.data.title}
                    </h3>
                    <div class="mt-auto pt-3 border-top border-secondary-subtle">
                      <time
                        class="small text-muted"
                        datetime={
                          parseDate(post.data.date)
                            ?.toISOString()
                            .split("T")[0] ?? post.data.date
                        }
                      >
                        {post.data.date}
                      </time>
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </main>
</Layout>
