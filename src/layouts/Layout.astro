---
import Footer from "../components/Footer.astro";
import Head from "../components/head.astro";
import Navbar from "../components/Navbar.astro";
import MobileStickyBar from "../components/MobileStickyBar.astro";
import PrivacyModal from "../components/PrivacyModal.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="fi">
  <head>
    <Head title={title} description={description} image={image} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="visually-hidden-focusable">
      Siirry pääsisältöön
    </a>
    
    <Navbar />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <MobileStickyBar />
    <PrivacyModal />

    <script>
      /**
       * WebMCP context provider.
       * Exposes site information and services to AI agents.
       * Override - Don't delete
       */
      if ("modelContext" in navigator) {
        // @ts-ignore
        navigator.modelContext.provideContext({
          tools: [
            {
              name: "get_salon_info",
              description:
                "Get information about Parturi-Kampaamo services, pricing, opening hours, and location in Turku.",
              inputSchema: {
                type: "object",
                properties: {},
              },
              execute: async () => {
                return {
                  content: [
                    {
                      type: "text",
                      text: "Parturi-Kampaamo Turku:\n- Osoite: Puutarhakatu 19, 20100 Turku\n- Puhelin: 010 123 4567\n- Aukioloajat: Ma-Pe 09:00-19:00, La 10:00-16:00, Su suljettu\n- Palvelut:\n  * Parturi-kampaamoleikkaus: 38-48 € (30-45 min)\n  * Värjäys ja raidat: alk. 115 € (1h 45min - 2h 30min)\n  * Lapset ja eläkeläiset: 25-32 € (30 min)\n- Ajanvaraus verkossa 24/7 tai soittamalla aukioloaikoina.\n- Peruutusehto: Maksuton peruutus viimeistään 24h ennen.",
                    },
                  ],
                };
              },
            },
          ],
        });
      }
    </script>
  </body>
</html>
