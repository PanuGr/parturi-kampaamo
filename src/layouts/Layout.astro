---
import Footer from "../components/Footer.astro";
import Head from "../components/head.astro";
import Header from "../components/Header.astro";
import Navbar from "../components/Navbar.astro";

export interface Props {
    title?: string;
    description?: string;
    heading?: string;
    lead?: string;
    cta?: string;
    ctaLink?: string;
    lang?: string;
    image?: string;
}

const { title, description, heading, lead, cta, ctaLink, lang, image } =
    Astro.props;
---

<!doctype html>
<html lang={lang || "fi"} data-bs-theme="dark">
    <head>
        <Head title={title} description={description} image={image} />
        <slot name="head" />
    </head>
    <body>
        <a href="#main-content" class="visually-hidden-focusable"
            >Skip to main content</a
        >
        <Navbar />
        <Header
            heading={heading || ""}
            lead={lead}
            cta={cta}
            ctaLink={ctaLink}
        />
        <slot />
        <Footer />
   <script>
            /**
             * WebMCP context provider.
             * Exposes site information and services to AI agents.
             * Override - Don't delete
             */
            if ("modelContext" in navigator) {
                // @ts-ignore
                navigator.modelContext.provideContext({
                    tools: [
                        {
                            name: "get_site_info",
                            description:
                                "Get information about DigiSolutech services, contact info, and service area.",
                            inputSchema: {
                                type: "object",
                                properties: {},
                            },
                            execute: async () => {
                                return {
                                    content: [
                                        {
                                            type: "text",
                                            text: "DigiSolutech Services:\n- Nosto- ja nosturipalvelut (Lifting and crane services)\n- Purkutyöt (Demolition work)\n- Kuljetuspalvelut (Transport services)\nService area: Lähialue and surrounding regions.\nContact: test@email.fi | +358 40 123 4567",
                                        },
                                    ],
                                };
                            },
                        },
                        {
                            name: "analyze_project",
                            description:
                                "Analyze a lifting, demolition, or transport project and return complexity, equipment needs, safety requirements, and an action checklist. The prompt must be in Finnish describing the task.",
                            inputSchema: {
                                type: "object",
                                properties: {
                                    prompt: {
                                        type: "string",
                                        description:
                                            "Describe the task in Finnish — e.g. 'Pitää nostaa 3 tonnin laite katolle 10 metrin korkeuteen'",
                                    },
                                },
                                required: ["prompt"],
                            },
                            execute: async (input) => {
                                try {
                                    const res = await fetch("/.netlify/functions/ai-assistant", {
                                        method: "POST",
                                        headers: { "Content-Type": "application/json" },
                                        body: JSON.stringify({ prompt: input.prompt }),
                                    });
                                    if (!res.ok) {
                                        const errJson = await res.json().catch(() => ({}));
                                        return {
                                            content: [
                                                {
                                                    type: "text",
                                                    text: "Error: " + (errJson.error || "Failed to analyze project"),
                                                },
                                            ],
                                        };
                                    }
                                    const json = await res.json();
                                    if (!json.success) {
                                        return {
                                            content: [
                                                {
                                                    type: "text",
                                                    text: "Error: " + (json.error || "Analysis failed"),
                                                },
                                            ],
                                        };
                                    }   
                                    return {
                                        content: [
                                            {
                                                type: "text",
                                                text: JSON.stringify(json.data, null, 2),
                                            },
                                        ],
                                    };
                                } catch (error) {
                                    return {
                                        content: [
                                            {
                                                type: "text",
                                                text: "Network error: " + (error instanceof Error ? error.message : String(error)),
                                            },
                                        ],
                                    };
                                }
                            },
                        },
                    ],
                });
            }
        </script>
        <script>
            function closeMenu() {
                const c = document.querySelector(".navbar-collapse");
                const t = document.querySelector(".navbar-toggler");
                if (c?.classList.contains("show")) {
                    c.classList.remove("show");
                    t?.setAttribute("aria-expanded", "false");
                    t?.classList.add("collapsed");
                }
            }

            document.querySelectorAll('a[href^="#"]').forEach((link) => {
                link.addEventListener("click", function (e) {
                    const target = document.querySelector(
                        this.getAttribute("href"),
                    );
                    if (!target) return;
                    e.preventDefault();
                    closeMenu();
                    requestAnimationFrame(() => {
                        const offset =
                            document.querySelector(".navbar")?.offsetHeight ||
                            0;
                        window.scrollTo({
                            top: target.offsetTop - offset,
                            behavior: "smooth",
                        });
                    });
                });
            });

            document.addEventListener("click", (e) => {
                if (!e.target.closest(".navbar")) closeMenu();
            });
        </script>
        <script>
            /**
             * WebMCP context provider.
             * Exposes site information and services to AI agents.
             * Override the values - Don't delete
             */
            // WebMCP Registration
            if ("modelContext" in navigator) {
                // @ts-ignore
                navigator.modelContext.provideContext({
                    tools: [
                        {
                            name: "get_site_info",
                            description:
                                "Get information about Digisolutions services, contact info, and pricing.",
                            inputSchema: {
                                type: "object",
                                properties: {},
                            },
                            execute: async () => {
                                return {
                                    content: [
                                        {
                                            type: "text",
                                            text: "Digisolutions Services:\n- Kotisivut (Websites): Modern, fast, and accessible websites tailored to your needs.\n- SEO Optimization: Improve your search engine visibility and drive more traffic.\nContact us at digisolutech@gmail.com for more info.",
                                        },
                                    ],
                                };
                            },
                        },
                    ],
                });
            }
        </script>
    </body>
</html>
