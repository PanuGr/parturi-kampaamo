---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { parseDate } from "../../data/date";

const ObjectValues = await getCollection("blog");

const sortedPosts = ObjectValues
    /* .filter(
        (post) =>
            !post.id?.includes("tietosuoja") &&
            !post.id?.includes("saavutettavuusseloste"),
    ) */
    .sort(
        (a, b) =>
            (parseDate(a.data.date)?.getTime() ?? 0) -
            (parseDate(b.data.date)?.getTime() ?? 0),
    );

// Group by year
const groupedPosts = sortedPosts.reduce(
    (acc, post) => {
        const year = parseDate(post.data.date)?.getFullYear() || 1970;
        if (!acc[year]) acc[year] = [];
        acc[year].push(post);
        return acc;
    },
    {} as Record<number, typeof sortedPosts>,
);

const years = Object.keys(groupedPosts)
    .map(Number)
    .sort((a, b) => a - b);
---

<style is:inline>
    #hero {
        display: none !important;
    }

    .link-hover {
        transition: color 0.2s ease;
    }

    .link-hover:hover {
        text-decoration: underline;
    }

    .archive-header {
        padding: 8rem 0 2rem;
    }
</style>

<Layout
    title="Blogiarkisto: Oppaita ja artikkeleita kotisivuista | DigiSolutech"
    description="Kaikki DigiSolutechin julkaisemat artikkelit ja oppaat yrityksille kotisivuista ja digitaalisista ratkaisuista kronologisessa järjestyksessä."
>
    <!-- Header to push past navbar -->
    <header class="archive-header text-center">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3 text-white">Blogiarkisto</h1>
            <p class="lead col-lg-8 mx-auto text-muted">
                Selaa kaikkia julkaisuja vuosien varrelta.
            </p>
        </div>
        <div class="text-center mt-5">
            <a
                href="/blog"
                class="btn btn-outline-light rounded-pill px-5 py-2"
            >
                &larr; Palaa kaikkiin artikkeleihin
            </a>
        </div>
    </header>

    <main class="container py-4 mb-5" style="max-width: 800px;">
        {
            years.map((year) => (
                <div class="mb-5 pb-4 border-bottom border-secondary-subtle">
                    <h2 class="h2 fw-bold text-white mb-4">{year}</h2>
                    <ul class="list-unstyled">
                        {groupedPosts[year].map((post) => (
                            <li class="mb-3 d-flex flex-column flex-md-row align-items-md-baseline gap-2 gap-md-4">
                                <time
                                    datetime={
                                        parseDate(post.data.date)
                                            ?.toISOString()
                                            .split("T")[0]
                                    }
                                    class="text-muted small fw-bold text-uppercase ls-1"
                                    style="min-width: 120px;"
                                >
                                    {post.data.date}
                                </time>
                                <div>
                                    <a
                                        href={`/blog/${post.id}`}
                                        class="link-offset-2 h5 mb-1 d-block link-hover"
                                    >
                                        {post.data.title}
                                    </a>
                                    <span class="badge bg-secondary rounded-pill small">
                                        {post.data.category}
                                    </span>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </main>
</Layout>
