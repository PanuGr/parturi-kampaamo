---
import Layout from "../../../layouts/Layout.astro";
import { parseDate } from "../../../data/date";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const allPosts = await getCollection("blog");
    const uniqueTags = [
        ...new Set(allPosts.flatMap((post) => post.data.tags || [])),
    ].filter(Boolean);

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) =>
            post.data.tags?.includes(tag),
        );
        return {
            params: { tag: tag.toLowerCase().replace(/\s+/g, "-") },
            props: { tag, posts: filteredPosts },
        };
    });
}

const { tag, posts } = Astro.props;

const sortedPosts = posts.sort(
    (a, b) =>
        (parseDate(b.data.date)?.getTime() ?? 0) -
        (parseDate(a.data.date)?.getTime() ?? 0),
);
---

<style is:inline>
    #hero {
        display: none !important;
    }

    .blog-header {
        padding: 8rem 0 0rem;
    }

    .card-img-top {
        transition: transform 0.5s ease;
    }

    .card:hover .card-img-top {
        transform: scale(1.05);
    }
</style>

<Layout
    title={`Artikkelit avainsanalla: ${tag} | DigiSolutech`}
    description={`Kaikki DigiSolutechin oppaat ja artikkelit avainsanalla ${tag}.`}
>
    <header class="blog-header text-center">
        <div class="container">
            <h1 class="display-3 fw-bold mb-3 text-white">
                Avainsana: <span class="text-accent-gradient">{tag}</span>
            </h1>
            <p class="lead col-lg-8 mx-auto text-muted">
                Löysit {sortedPosts.length}
                {sortedPosts.length === 1 ? "artikkelin" : "artikkelia"}, jotka
                liittyvät aiheeseen <strong>{tag}</strong>.
            </p>
        </div>
    </header>

    <main id="main-content" class="container py-5 mt-4 mb-5">
        <div class="mb-5 text-center">
            <a
                href="/blog"
                class="btn btn-outline-primary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="m15 18-6-6 6-6"></path></svg
                >
                Takaisin kaikkiin artikkeleihin
            </a>
        </div>

        <div class="row g-4" id="articles-grid">
            {
                sortedPosts.map((post) => (
                    <div class="col-md-6 col-lg-4 article-card">
                        <a
                            href={`/blog/${post.id}`}
                            class="card text-decoration-none h-100"
                        >
                            {post.data.image && (
                                <div class="overflow-hidden">
                                    <img
                                        src={post.data.image}
                                        alt={post.data.title}
                                        class="card-img-top img-fluid"
                                        loading="lazy"
                                        onerror="this.src='https://images.unsplash.com/photo-1512314889357-e157c22f938d?w=800&auto=format&fit=crop&q=80'"
                                    />
                                </div>
                            )}
                            <div class="card-body p-4 d-flex flex-column">
                                <span class="text-accent fw-bold text-uppercase small ls-1 mb-2">
                                    {post.data.category}
                                </span>
                                <h2 class="card-title h4 fw-bold text-white mb-3">
                                    {post.data.title}
                                </h2>
                                {post.data.description && (
                                    <p class="card-text text-muted description-clamp mb-4">
                                        {post.data.description}
                                    </p>
                                )}
                                <div class="mt-auto pt-3 border-top border-secondary-subtle">
                                    <time
                                        class="small text-muted"
                                        datetime={
                                            parseDate(post.data.date)
                                                ?.toISOString()
                                                .split("T")[0]
                                        }
                                    >
                                        {post.data.date}
                                    </time>
                                </div>
                            </div>
                        </a>
                    </div>
                ))
            }
        </div>
    </main>
</Layout>
