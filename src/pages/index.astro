          <Calendar size={18} />
        </a>
        <a href={SALON_INFO.phoneTel} class="btn btn-outline-light px-4 py-3">
          <Phone size={18} />
          <span>Soita {SALON_INFO.phone}</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
